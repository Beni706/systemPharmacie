// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model pharmacies {
  id_pharmacie        Int     @id @default(autoincrement())
  nom                 String  @unique
  adresse             String
  latitude            Float
  longitude           Float
  telephone           String?
  services            String?
  info_supplementaire String?
}

model administrateur {
  id_administrateur Int    @id @default(autoincrement())
  nom_prenom        String
  email             String @unique
  password          String
}

model followers {
  id_follower Int    @id @default(autoincrement())
  nom         String
  prenom      String
  email       String @unique
  password    String
}
