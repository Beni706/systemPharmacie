// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model pharmacies {
    id_pharmacie        Int     @id @default(autoincrement())
    nom                 String  @unique
    adresse             String
    latitude            Float
    longitude           Float
    telephone           Int?
    services            String?
    info_supplementaire String?
  }
  
  
  model administrateur {
    id_administrateur Int    @id @default(autoincrement())
    nom_prenom        String
    email             String @unique
    password          String
  }